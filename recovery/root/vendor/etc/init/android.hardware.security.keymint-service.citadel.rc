

service vendor.keymint-citadel /vendor/bin/hw/android.hardware.security.keymint-service.citadel
    class hal
    user root
    group root drmrp
    # interface aidl android.hardware.security.keymint.IKeyMintDevice/strongbox
    interface aidl android.hardware.security.keymint.IKeyMintDevice/strongbox
    interface aidl android.hardware.security.sharedsecret.ISharedSecret/strongbox
    seclabel u:r:recovery:s0
